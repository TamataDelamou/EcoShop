# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Configuration Firebase propre à chaque projet (notifications push) :
# déposée sur le poste de construction, jamais dans le dépôt.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Publication : clé de signature et configuration de production, propres au
# poste de construction (scripts/construire_android.ps1).
android/key.properties
*.jks
*.keystore
config/*.json
!config/*.exemple.json
