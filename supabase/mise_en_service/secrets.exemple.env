# ============================================================================
# EcoShop — Secrets de production (modèle)
#
# Le script scripts/deployer_supabase.ps1 copie ce fichier en
# secrets.local.env (ignoré par git) et l'ouvre : remplir les valeurs,
# enregistrer, relancer le script. Une ligne vide = fonction désactivée,
# jamais une erreur : on peut déployer d'abord, compléter ensuite.
#
# Ne JAMAIS envoyer ce fichier rempli par messagerie, courriel ou chat.
# ============================================================================

# --- Projet --------------------------------------------------------------------
# Identifiant du projet Supabase (Settings → General → Reference ID).
PROJET_REF=
# Compte qui devient administrateur GSG (créé d'abord dans l'application).
ADMIN_GSG_COURRIEL=
ADMIN_GSG_TELEPHONE=

# --- Déclencheurs des tâches planifiées (générés par le script si vides) ------
NOTIFICATIONS_DECLENCHEUR_SECRET=
PAIEMENTS_DECLENCHEUR_SECRET=

# --- Courriels (Brevo) — docs/DEPLOIEMENT_COURRIEL.md ---------------------------
BREVO_API_KEY=
COURRIEL_EXPEDITEUR=ne-pas-repondre@globalservicegroupe.com
COURRIEL_EXPEDITEUR_NOM=EcoShop
COURRIEL_SUPPORT=contact@globalservicegroupe.com
COURRIEL_ADMIN_GSG=direction@globalservicegroupe.com
URL_APPLICATION=

# --- Notifications push (Firebase) — docs/DEPLOIEMENT_PUSH.md ----------------
# Chemin du fichier JSON du compte de service (le script le lit lui-même).
FCM_COMPTE_SERVICE_FICHIER=

# --- SMS Orange Guinée (écoles + codes de connexion) --------------------------
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_EXPEDITEUR=2240000
ORANGE_SMS_NOM_EXPEDITEUR=
# Secret du crochet « Send SMS » (Authentication → Hooks → Generate secret).
SEND_SMS_HOOK_SECRETS=

# --- Orange Money (retour dans l'application après paiement) ------------------
ORANGE_MONEY_URL_RETOUR=io.gsg.ecoshop://paiement/retour

# --- Kernel GSG (facultatif tant que le Control Plane n'est pas en ligne) -----
KERNEL_EXPORT_DECLENCHEUR_SECRET=
GSG_KERNEL_AGGREGATION_URL=
GSG_KERNEL_JWKS_URL=
GSG_KERNEL_ISSUER=
KERNEL_INTERSERVICES_CLE_PRIVEE_JWK=
